// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

//
// ENUMS
//

enum Role {
  OWNER
  ADMIN
  MEMBER
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

enum EntityType {
  TASK
  EVENT
  NOTE
  TRANSACTION
}

enum MetricType {
  NUMBER
  CURRENCY
  DURATION
  BOOLEAN
}

enum TransactionType {
  INCOME
  EXPENSE
}

//
// CORE
//

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  timezone  String?
  createdAt DateTime @default(now()) @map("created_at")

  memberships Membership[]
  workspaces  Workspace[]

  @@map("users")
}

model Workspace {
  id        String   @id @default(cuid())
  name      String
  ownerId   String   @map("owner_id")
  createdAt DateTime @default(now()) @map("created_at")

  owner        User          @relation(fields: [ownerId], references: [id])
  memberships  Membership[]
  tags         Tag[]
  attachments  Attachment[]
  tasks        Task[]
  events       Event[]
  notes        Note[]
  metrics      Metric[]
  records      Record[]
  transactions Transaction[]
  timeBlocks   TimeBlock[]
  links        Link[]

  @@map("workspaces")
}

model Membership {
  id          String @id @default(cuid())
  userId      String @map("user_id")
  workspaceId String @map("workspace_id")
  role        Role

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
  @@map("memberships")
}

//
// TAGGING
//

model Tag {
  id          String  @id @default(cuid())
  workspaceId String  @map("workspace_id")
  name        String
  color       String?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  taggings  Tagging[]

  @@map("tags")
}

model Tagging {
  id         String     @id @default(cuid())
  tagId      String     @map("tag_id")
  entityType EntityType @map("entity_type")
  entityId   String     @map("entity_id")

  tag Tag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@index([entityType, entityId])
  @@map("taggings")
}

//
// ATTACHMENTS
//

model Attachment {
  id          String   @id @default(cuid())
  workspaceId String   @map("workspace_id")
  url         String
  type        String?
  size        Int?
  createdAt   DateTime @default(now()) @map("created_at")

  workspace Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  links     AttachmentLink[]

  @@map("attachments")
}

model AttachmentLink {
  id           String     @id @default(cuid())
  attachmentId String     @map("attachment_id")
  entityType   EntityType @map("entity_type")
  entityId     String     @map("entity_id")

  attachment Attachment @relation(fields: [attachmentId], references: [id], onDelete: Cascade)

  @@index([entityType, entityId])
  @@map("attachment_links")
}

//
// TASKS
//

model Task {
  id          String     @id @default(cuid())
  workspaceId String     @map("workspace_id")
  title       String
  description String?
  status      TaskStatus @default(TODO)
  priority    Priority?
  dueAt       DateTime?  @map("due_at")
  scheduledAt DateTime?  @map("scheduled_at")
  createdBy   String     @map("created_by")
  createdAt   DateTime   @default(now()) @map("created_at")

  workspace  Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  timeBlocks TimeBlock[]

  @@map("tasks")
}

//
// EVENTS
//

model Event {
  id          String    @id @default(cuid())
  workspaceId String    @map("workspace_id")
  title       String
  description String?
  startAt     DateTime  @map("start_at")
  endAt       DateTime  @map("end_at")
  allDay      Boolean   @default(false) @map("all_day")
  location    String?
  createdBy   String    @map("created_by")
  createdAt   DateTime  @default(now()) @map("created_at")
  deletedAt   DateTime? @map("deleted_at")

  workspace  Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  timeBlocks TimeBlock[]

  @@map("events")
}

//
// TIME BLOCK
//

model TimeBlock {
  id          String   @id @default(cuid())
  workspaceId String   @map("workspace_id")
  startAt     DateTime @map("start_at")
  endAt       DateTime @map("end_at")

  taskId  String? @map("task_id")
  eventId String? @map("event_id")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  task      Task?     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  event     Event?    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([startAt, endAt])
  @@map("time_blocks")
}

//
// NOTES
//

model Note {
  id          String    @id @default(cuid())
  workspaceId String    @map("workspace_id")
  title       String?
  content     Json
  parentId    String?   @map("parent_id")
  createdBy   String    @map("created_by")
  createdAt   DateTime  @default(now()) @map("created_at")
  deletedAt   DateTime? @map("deleted_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  parent   Note?  @relation("NoteToNote", fields: [parentId], references: [id], onDelete: Cascade)
  children Note[] @relation("NoteToNote")

  @@map("notes")
}

//
// METRICS
//

model Metric {
  id          String     @id @default(cuid())
  workspaceId String     @map("workspace_id")
  name        String
  type        MetricType
  unit        String?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  records   Record[]

  @@map("metrics")
}

model Record {
  id          String    @id @default(cuid())
  workspaceId String    @map("workspace_id")
  metricId    String    @map("metric_id")
  value       Float
  recordedAt  DateTime  @map("recorded_at")
  deletedAt   DateTime? @map("deleted_at")
  source      String?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  metric    Metric    @relation(fields: [metricId], references: [id], onDelete: Cascade)

  @@index([metricId, recordedAt])
  @@map("records")
}

//
// TRANSACTIONS
//

model Transaction {
  id          String          @id @default(cuid())
  workspaceId String          @map("workspace_id")
  amount      Float
  type        TransactionType
  category    String?
  occurredAt  DateTime        @map("occurred_at")
  note        String?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("transactions")
}

//
// LINKS
//

model Link {
  id          String @id @default(cuid())
  workspaceId String @map("workspace_id")

  fromType EntityType @map("from_type")
  fromId   String     @map("from_id")

  toType EntityType @map("to_type")
  toId   String     @map("to_id")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([fromType, fromId])
  @@index([toType, toId])
  @@map("links")
}
